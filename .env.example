# WhiteBox AI — environment configuration
#
# Email + password auth works out of the box (backed by a local SQLite DB at
# data/whitebox.db — no config needed).
#
# Sign-in with Google / Microsoft requires YOU to register an OAuth app with the
# provider and paste the two values below — this is a hard requirement of OAuth
# for every app (Slack, Notion, everyone). Copy this file to `.env`, fill it in,
# then restart `npm run dev`. See SETUP-OAUTH.md for the 2-minute walkthrough.

# Google — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:  http://localhost:4311/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft (Entra ID) — https://portal.azure.com → App registrations
# Redirect URI (Web):       http://localhost:4311/api/auth/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ─── Corporate / TLS-inspecting networks ──────────────────────────────────────
# If your machine is behind a proxy that rewrites certs (the "UNABLE_TO_VERIFY"
# error), point Node at your corporate root CA so the server→provider token
# exchange succeeds. The dev script already passes --use-system-ca as well.
# NODE_EXTRA_CA_CERTS=C:\path\to\corporate-root-ca.pem
