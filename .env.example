# Copy to .env.local to switch the /api/ai routes onto real Claude calls.
#
# With no credential set the app still works: every authoring endpoint falls
# back to the deterministic generator in lib/ai.ts and returns
# meta.source = "local", which the studio surfaces as a visible notice. Nothing
# is presented as a model output unless a model actually produced it.

ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_MAX_TOKENS=16000
